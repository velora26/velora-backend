{
  "name": "velora-backend",
  "version": "1.0.0",
  "description": "Premium E-commerce backend API for Velora",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
